    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate a social media post on this topic:\n\nTopic: {{ $json['Topic of Post'] }}\n\nTarget Audience: {{ $json['Target Audience'] }}\n\nReturn ONLY valid JSON in this format:\n{\n  \"linkedin_caption\": \"professional tone, 100-150 words\",\n  \"facebook_caption\": \"casual, short, 2-3 lines\",\n  \"instagram_caption\": \"with emojis and 8-10 hashtags\",\n  \"image_prompt\": \"detailed English prompt for image generation\"\n}",
        "options": {
          "systemMessage": "You are a social media content expert.\nUse a different tone for each platform.\nRespond only with valid JSON. No extra text and no markdown backticks.\nBefore writing, use the Tavily tool to search for the latest facts about the topic. Use only verified information from the search results. Still return ONLY valid JSON."
        }
