    {
      "parameters": {
        "promptType": "define",
        "text": "Generate today's a new vocabulary word.\n\nFirst check the Google Sheet for previously used words.\nDo not use any word that is already present in the sheet.\n\nReturn exactly 1 new word with:\nWord, Meaning, Example, Synonym, Date, Pronunciation.",
        "options": {
          "systemMessage": "You are a Daily English Vocabulary Assistant.\n\nGenerate exactly 1 useful intermediate-level English vocabulary word every day.\n\nThe Google Sheet contains previously used words in the \"Word\" column.\nBefore generating new words, check the Google Sheet and NEVER repeat a word that already exists there.\n\nThe new word must be unique.\n\nFor each word provide:\n- Word\n- Meaning\n- Example\n- Synonym\n- Date\n- Pronunciation\n\nAlways use the current date."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        0
      ],
      "id": "ef33e2ba-a962-4209-8f5d-bbc571d28cef",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        448,
        160
      ],
      "id": "fe631333-2750-4e9e-af98-2f48037631d6",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_API_KEY",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $json.output;\n\nconst word = text.match(/\\*\\*Word:\\*\\*\\s*(.*)/)?.[1]?.trim();\nconst meaning = text.match(/\\*\\*Meaning:\\*\\*\\s*(.*)/)?.[1]?.trim();\nconst example = text.match(/\\*\\*Example:\\*\\*\\s*(.*)/)?.[1]?.trim();\nconst synonym = text.match(/\\*\\*Synonym:\\*\\*\\s*(.*)/)?.[1]?.trim();\nconst date = text.match(/\\*\\*Date:\\*\\*\\s*(.*)/)?.[1]?.trim();\nconst pronunciation = text.match(/\\*\\*Pronunciation:\\*\\*\\s*(.*)/)?.[1]?.trim();\n\nreturn [{\n  json: {\n    Word: word,\n    Meaning: meaning,\n    Example: example,\n    Synonym: synonym,\n    Date: date,\n    Pronunciation: pronunciation\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
