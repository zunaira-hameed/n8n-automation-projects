      "parameters": {
        "jsCode": "// Form Trigger se data uthao\nconst invoiceNumber = $json['Invoice Number'];\nconst senderName    = $json['Sender Name'];\nconst senderEmail   = $json['Sender Email'];\nconst senderAddress = $json['Sender Address'];\nconst totalAmount   = $json['Total Amount'];\nconst invoiceDate   = $json['Invoice Date'];\nconst dueDate       = $json['Due Date'];\n\n// Amount ko formatted currency banao\nconst formattedAmount = Number(totalAmount).toLocaleString('en-US', {\n  minimumFractionDigits: 2,\n  maximumFractionDigits: 2\n});\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body {\n    font-family: Arial, Helvetica, sans-serif;\n    color: #2b2b2b;\n    margin: 0;\n    padding: 40px;\n  }\n  .invoice-box {\n    max-width: 800px;\n    margin: auto;\n  }\n  h1 {\n    font-size: 32px;\n    color: #23324D;\n    margin-bottom: 4px;\n  }\n  .subtitle {\n    color: #888;\n    font-size: 13px;\n    margin-bottom: 30px;\n  }\n  .top-section {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 30px;\n  }\n  .sender-info, .invoice-meta {\n    font-size: 14px;\n    line-height: 1.6;\n  }\n  .invoice-meta {\n    text-align: right;\n  }\n  .invoice-meta strong {\n    color: #23324D;\n  }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 20px;\n  }\n  th {\n    background-color: #23324D;\n    color: #ffffff;\n    text-align: left;\n    padding: 10px 14px;\n    font-size: 14px;\n  }\n  td {\n    padding: 14px;\n    font-size: 14px;\n    border-bottom: 1px solid #e0e0e0;\n  }\n  .amount-cell {\n    text-align: right;\n    font-weight: bold;\n    color: #23324D;\n  }\n  .total-row td {\n    font-size: 18px;\n    font-weight: bold;\n    border-top: 2px solid #23324D;\n    border-bottom: none;\n  }\n  .footer {\n    margin-top: 40px;\n    font-size: 12px;\n    color: #999;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n  <div class=\"invoice-box\">\n    <h1>INVOICE</h1>\n    <div class=\"subtitle\">Invoice #${invoiceNumber}</div>\n\n    <div class=\"top-section\">\n      <div class=\"sender-info\">\n        <strong>${senderName}</strong><br>\n        ${senderAddress}<br>\n        ${senderEmail}\n      </div>\n      <div class=\"invoice-meta\">\n        <div><strong>Invoice Date:</strong> ${invoiceDate}</div>\n        <div><strong>Due Date:</strong> ${dueDate}</div>\n        <div><strong>Invoice #:</strong> ${invoiceNumber}</div>\n      </div>\n    </div>\n\n    <table>\n      <thead>\n        <tr>\n          <th>Description</th>\n          <th style=\"text-align:right;\">Amount</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Invoice submitted by ${senderName}</td>\n          <td class=\"amount-cell\">$${formattedAmount}</td>\n        </tr>\n        <tr class=\"total-row\">\n          <td>Total Due</td>\n          <td class=\"amount-cell\">$${formattedAmount}</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"footer\">\n      Generated automatically via n8n &mdash; Thank you!\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{ json: { html, invoiceNumber, senderName } }];"
      },
