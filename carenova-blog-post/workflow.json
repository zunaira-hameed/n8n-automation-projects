    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a professional hero-image design for this health blog article.\n\nGenerate ONLY a complete self-contained HTML document with inline CSS.\n\nRequirements:\n- 16:9 landscape composition.\n- Professional, modern health/wellness website aesthetic.\n- Visually communicate the article's main topic.\n- Use CSS shapes, gradients, icons/emojis, typography, and layout creatively.\n- Do not use external images, external fonts, JavaScript, or external resources.\n- Keep the design clean and uncluttered.\n- Include a short, attractive headline if appropriate.\n- Make all text highly readable.\n- The design must look like a professionally designed blog hero graphic, not a plain webpage.\n- Use a fixed canvas suitable for conversion to an image.\n- Return ONLY the HTML document. No explanation or Markdown code fences.\n\nARTICLE:\n{{ $json.text }}",
        "batching": {}
